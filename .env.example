# ===== 必填：对话/推理 API（缺失将无法启动，见 config.validate_critical_env）=====
DASHSCOPE_API_KEY=your-dashscope-api-key

# ===== 必填：LLM 模型名 =====
LLM_MODEL=qwen3-max

# ===== 可选：联网搜索（未配置时联网搜索功能降级）=====
TAVILY_API_KEY=your-tavily-api-key

# ===== 可选：健康数据落盘加密 =====
# 配置后 storage_io 会对 JSON 落盘做 Fernet 对称加密（未配置则明文存储 + 打印告警）。
# DATA_ENC_KEY=<用 Fernet.generate_key() 生成>

# ===== 可选：高德地图（位置/路线/医院查询，未配置时相关功能降级）=====
GAODE_MAP_KEY=your-gaode-map-key

# ===== 向量化（注意：需与重建知识库时保持一致）=====
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_DIM=512
HF_ENDPOINT=https://hf-mirror.com

# ===== 重排（RAG 检索精排，cross-encoder）=====
# RERANK_ENABLED=1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_MAX_LENGTH=1024
# RERANK_CACHE_DIR=.cache/sentence_transformers

# ===== RAG 低质量检索判定阈值 =====
# LOW_QUALITY_RULE_THRESHOLD=0.0
# LOW_QUALITY_CROSS_THRESHOLD=0.25